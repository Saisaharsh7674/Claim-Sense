        <fullName>Claim_Status_Check_16j09b22c3318c4</fullName>
        <canEscalate>false</canEscalate>
        <description>Use this subagent when a dealer asks about the status, progress, or decision of an already submitted warranty claim.</description>
        <developerName>Claim_Status_Check_16j09b22c3318c4</developerName>
        <genAiPluginInstructions>
            <description>When a dealer asks about the status of an existing warranty claim, ask for the claim reference number if it is not already provided. Once the claim reference number is available, call the &quot;Check Claim Status&quot; action using that reference number to retrieve the claim details. Share the retrieved information with the dealer, including the current claim status, the last updated date, and any approver or reviewer notes associated with the claim.</description>
            <developerName>instruction_1</developerName>
            <language xsi:nil="true"/>
            <masterLabel>Instruction 1</masterLabel>
            <sortOrder>0</sortOrder>
        </genAiPluginInstructions>
        <genAiPluginInstructions>
            <description>If the retrieved information indicates that further action is required from the dealer, clearly explain the next steps. Do not estimate approval timelines, do not predict approval or rejection, and do not provide outcome assumptions.</description>
            <developerName>instruction_2</developerName>
            <language xsi:nil="true"/>
            <masterLabel>Instruction 2</masterLabel>
            <sortOrder>1</sortOrder>
        </genAiPluginInstructions>
