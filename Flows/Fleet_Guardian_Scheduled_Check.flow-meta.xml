        </assignmentItems>
        <assignmentItems>
            <assignToReference>varPartNumbers</assignToReference>
            <operator>Add</operator>
            <value>
                <stringValue>INFO-ECU-STD</stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varPartNumbers</assignToReference>
            <operator>Add</operator>
            <value>
                <stringValue>SUSP-STR-E9F</stringValue>
            </value>
        </assignmentItems>
