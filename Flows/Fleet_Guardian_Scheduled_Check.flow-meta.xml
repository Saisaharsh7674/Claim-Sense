                <elementReference>varClaimItems</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Check_Claim_Threshold</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Assign_VehicleModel</name>
        <label>Assign Vehicle Model From ClaimItem</label>
        <locationX>50</locationX>
        <locationY>743</locationY>
        <assignmentItems>
            <assignToReference>varVehicleModel</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue></stringValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Invoke_Fleet_Guardian_Response</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Init_PartNumbers</name>
        <label>Initialize Part Numbers</label>
        <locationX>1040</locationX>
        <locationY>50</locationY>
        <assignmentItems>
            <assignToReference>varPartNumbers</assignToReference>
            <operator>Add</operator>
            <value>
                <stringValue>AC-COMP-E9</stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varPartNumbers</assignToReference>
            <operator>Add</operator>
            <value>
                <stringValue>BMS-E7-STD</stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varPartNumbers</assignToReference>
            <operator>Add</operator>
            <value>
                <stringValue>BRAKE-CAL-E9F</stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varPartNumbers</assignToReference>
            <operator>Add</operator>
            <value>
                <stringValue>AC-COMP-E7</stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varPartNumbers</assignToReference>
            <operator>Add</operator>
            <value>
                <stringValue>EMC-E11-PRO</stringValue>
