    <decisions>
        <name>Check_Claim_Threshold</name>
        <label>Claim Count Above Threshold?</label>
        <locationX>663</locationX>
        <locationY>575</locationY>
        <defaultConnector>
            <targetReference>Loop_PartNumbers</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Below Threshold</defaultConnectorLabel>
        <rules>
            <name>Above_Threshold</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varClaimCount</leftValueReference>
                <operator>GreaterThanOrEqualTo</operator>
                <rightValue>
                    <numberValue>5.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Existing_Case</targetReference>
            </connector>
            <label>At or Above Threshold (&gt;=5)</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_No_Existing_Case</name>
        <label>No Existing Open Case?</label>
        <locationX>874</locationX>
        <locationY>669</locationY>
        <defaultConnector>
            <targetReference>Loop_PartNumbers</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Case Already Exists</defaultConnectorLabel>
        <rules>
            <name>No_Existing_Case</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varExistingCase</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Sample_ClaimItem</targetReference>
            </connector>
            <label>No Existing Case (Null)</label>
        </rules>
    </decisions>
    <description>DEMO FLOW — Fleet Guardian Scheduled Check. Runs every hour. Iterates over fleet part numbers, counts warranty claims in the last 30 days, and invokes Fleet_Guardian_Response_Flow when the threshold (5) is reached and no open High-priority Case already exists. PRODUCTION: replace the in-loop Get Records count query with an Apex @InvocableMethod aggregate SOQL for governor-limit safety.</description>
    <environments>Default</environments>
    <formulas>
        <name>varThirtyDaysAgo</name>
        <dataType>DateTime</dataType>
        <expression>NOW() - 30</expression>
    </formulas>
    <interviewLabel>Fleet Guardian Scheduled Check {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Fleet Guardian Scheduled Check</label>
    <loops>
        <name>Loop_PartNumbers</name>
        <label>Loop Part Numbers</label>
        <locationX>679</locationX>
        <locationY>299</locationY>
        <assignNextValueToReference>loopPartNumber</assignNextValueToReference>
        <collectionReference>varPartNumbers</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Get_ClaimCount_For_Part</targetReference>
        </nextValueConnector>
    </loops>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>FREE_FORM_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_ClaimCount_For_Part</name>
        <label>Get Claim Items For Part (Count)</label>
        <locationX>50</locationX>
        <locationY>458</locationY>
        <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Assign_ClaimCount</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Loop_PartNumbers</targetReference>
        </faultConnector>
        <filterLogic>1 AND 2</filterLogic>
        <filters>
            <field>Part_Number__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>loopPartNumber</elementReference>
            </value>
        </filters>
        <filters>
            <field>CreatedDate</field>
            <operator>GreaterThanOrEqualTo</operator>
            <value>
                <elementReference>varThirtyDaysAgo</elementReference>
            </value>
        </filters>
        <object>ClaimItem</object>
        <outputReference>varClaimItems</outputReference>
        <queriedFields>Id</queriedFields>
    </recordLookups>
    <recordLookups>
        <name>Get_Existing_Case</name>
        <label>Get Existing Open High-Priority Case</label>
        <locationX>1040</locationX>
        <locationY>865</locationY>
        <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Check_No_Existing_Case</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Loop_PartNumbers</targetReference>
        </faultConnector>
        <filterLogic>1 AND 2 AND 3</filterLogic>
        <filters>
            <field>Subject</field>
            <operator>Contains</operator>
            <value>
                <elementReference>loopPartNumber</elementReference>
            </value>
        </filters>
        <filters>
            <field>Status</field>
            <operator>NotEqualTo</operator>
            <value>
                <stringValue>Closed</stringValue>
            </value>
        </filters>
        <filters>
            <field>Priority</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>High</stringValue>
            </value>
        </filters>
        <object>Case</object>
        <outputReference>varExistingCase</outputReference>
        <queriedFields>Id</queriedFields>
        <queriedFields>Subject</queriedFields>
        <queriedFields>Status</queriedFields>
        <queriedFields>Priority</queriedFields>
    </recordLookups>
    <recordLookups>
        <name>Get_Sample_ClaimItem</name>
        <label>Get Sample ClaimItem (Vehicle Model)</label>
        <locationX>126</locationX>
        <locationY>791</locationY>
        <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Assign_VehicleModel</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Loop_PartNumbers</targetReference>
        </faultConnector>
        <filterLogic>1 AND 2</filterLogic>
        <filters>
            <field>Part_Number__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>loopPartNumber</elementReference>
            </value>
        </filters>
        <filters>
            <field>CreatedDate</field>
            <operator>GreaterThanOrEqualTo</operator>
            <value>
                <elementReference>varThirtyDaysAgo</elementReference>
            </value>
        </filters>
        <object>ClaimItem</object>
        <outputReference>varSampleClaimItem</outputReference>
        <queriedFields>Id</queriedFields>
        <queriedFields>Part_Number__c</queriedFields>
    </recordLookups>
    <start>
        <locationX>1244</locationX>
        <locationY>211</locationY>
        <connector>
            <targetReference>Init_PartNumbers</targetReference>
        </connector>
        <schedule>
            <dayOfMonthToRun>0</dayOfMonthToRun>
