        <rules>
            <name>Anomaly</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varFleetCount</leftValueReference>
                <operator>GreaterThanOrEqualTo</operator>
                <rightValue>
                    <numberValue>5.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Anomaly_Risk</targetReference>
            </connector>
            <label>Anomaly</label>
        </rules>
        <rules>
            <name>Complex</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
