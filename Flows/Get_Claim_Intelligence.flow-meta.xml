    <decisions>
        <name>Build_Recommendation</name>
        <label>Build Recommendation</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Assign_Recommendation_Review</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>General Review</defaultConnectorLabel>
        <rules>
            <name>Anomaly_Rec</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varClaim.Fleet_Anomaly_Flag__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_Recommendation_Anomaly</targetReference>
            </connector>
            <label>Anomaly Flagged</label>
        </rules>
        <rules>
            <name>Prior_Claim_Rec</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>frmPriorNotNull</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_Recommendation_Prior</targetReference>
            </connector>
            <label>Prior Claim Found</label>
        </rules>
        <rules>
            <name>Trusted_Dealer_Low_Risk</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varDealer.Dealer_Trust_Score__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>High</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>varClaim.Risk_Score__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Low</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_Recommendation_Trusted</targetReference>
            </connector>
            <label>Trusted Dealer Low Risk</label>
        </rules>
    </decisions>
