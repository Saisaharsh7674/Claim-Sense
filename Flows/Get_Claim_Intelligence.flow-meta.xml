    <description>Returns complete intelligence package for a claim for approver review</description>
    <environments>Default</environments>
    <formulas>
        <name>frmClaimedAmountText</name>
        <dataType>String</dataType>
        <expression>&quot;₹&quot; &amp; TEXT({!varClaimItem.TotalAmount__c})</expression>
    </formulas>
    <formulas>
        <name>frmDealerRateText</name>
        <dataType>String</dataType>
        <expression>TEXT({!varDealer.Dealer_Approval_Rate__c}) &amp; &quot;%&quot;</expression>
    </formulas>
    <formulas>
        <name>frmMileageText</name>
        <dataType>String</dataType>
        <expression>TEXT({!varClaimItem.Vehicle_Mileage_At_Failure__c}) &amp; &quot; km&quot;</expression>
    </formulas>
    <formulas>
        <name>frmPriorNotNull</name>
        <dataType>Boolean</dataType>
        <expression>NOT(ISBLANK({!varPriorClaim.Id}))</expression>
    </formulas>
    <formulas>
        <name>frmUseClaimId</name>
        <dataType>Boolean</dataType>
        <expression>NOT(ISBLANK({!inputClaimId}))</expression>
    </formulas>
    <formulas>
        <name>frmWarrantyExpiryText</name>
        <dataType>String</dataType>
        <expression>IF(NOT(ISBLANK({!varAssetWarranty.EndDate})), TEXT(MONTH({!varAssetWarranty.EndDate})) &amp; &quot;/&quot; &amp; TEXT(YEAR({!varAssetWarranty.EndDate})), &quot;N/A&quot;)</expression>
    </formulas>
    <formulas>
        <name>frmWarrantyStatusText</name>
        <dataType>String</dataType>
        <expression>IF(NOT(ISBLANK({!varAssetWarranty.Id})), &quot;Active&quot;, &quot;Inactive&quot;)</expression>
    </formulas>
    <formulas>
        <name>outputSummary</name>
        <dataType>String</dataType>
        <expression>&quot;Claim Number: &quot; &amp; {!varClaim.Name} &amp; BR() &amp;
&quot;Claim Status: &quot; &amp; TEXT({!varClaim.Status}) &amp; BR() &amp; BR() &amp;
&quot;Dealer Name: &quot; &amp; {!varDealer.Name} &amp; BR() &amp;
&quot;Dealer Trust Score: &quot; &amp; TEXT({!varDealer.Dealer_Trust_Score__c}) &amp; BR() &amp;
&quot;Dealer Approval Rate: &quot; &amp; {!frmDealerRateText} &amp; BR() &amp; BR() &amp;
&quot;Part Number: &quot; &amp; {!varClaimItem.Part_Number__c} &amp; BR() &amp;
&quot;Part Description: &quot; &amp; {!varClaimItem.Description} &amp; BR() &amp;
&quot;Claimed Amount: &quot; &amp; {!frmClaimedAmountText} &amp; BR() &amp;
&quot;Vehicle Mileage: &quot; &amp; {!frmMileageText} &amp; BR() &amp; BR() &amp;
&quot;Failure Description: &quot; &amp; {!varClaimItem.Failure_Description__c} &amp; BR() &amp; BR() &amp;
&quot;Prior Claim Found: &quot; &amp;
IF(
  {!frmPriorNotNull},
  &quot;Yes&quot;,
  &quot;No&quot;
) &amp; BR() &amp;
IF(
  {!frmPriorNotNull},
  &quot;Prior Claim Number: &quot; &amp; {!varPriorClaim.Name} &amp; BR(),
  &quot;&quot;
) &amp; BR() &amp;
&quot;Fleet Claim Count (Last 30 Days): &quot; &amp;
TEXT({!varClaimItem.Fleet_Claim_Count_30Days__c}) &amp; BR() &amp;
&quot;Risk Score: &quot; &amp;
TEXT({!varClaim.Risk_Score__c}) &amp; BR() &amp;
&quot;Triage Category: &quot; &amp;
TEXT({!varClaim.Triage_Category__c}) &amp; BR() &amp;
&quot;Fleet Anomaly Flag: &quot; &amp;
IF(
  {!varClaim.Fleet_Anomaly_Flag__c},
  &quot;Yes&quot;,
  &quot;No&quot;
) &amp; BR() &amp; BR() &amp;
&quot;Engineering Case ID: &quot; &amp;
IF(
  ISBLANK({!varEngCase.Id}),
  &quot;Not Available&quot;,
  {!varEngCase.Id}
) &amp; BR() &amp;
&quot;Engineering Case Subject: &quot; &amp;
IF(
  ISBLANK({!varEngCase.Subject}),
  &quot;Not Available&quot;,
  {!varEngCase.Subject}
) &amp; BR() &amp; BR() &amp;
&quot;Warranty Status: &quot; &amp; {!frmWarrantyStatusText} &amp; BR() &amp; BR() &amp;
&quot;Recommendation: &quot; &amp; {!varRecommendation} &amp; BR() &amp; BR() &amp;
&quot;Warranty Expiry:&quot; &amp; {!frmWarrantyExpiryText}</expression>
    </formulas>
