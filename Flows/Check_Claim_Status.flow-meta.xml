<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>66.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Set_Not_Found_Error</name>
        <label>Set Not Found Error</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>outputFound</assignToReference>
            <operator>Assign</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>outputErrorMessage</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>No claim found with that reference number. Please check and try again.</stringValue>
            </value>
        </assignmentItems>
    </assignments>
    <assignments>
        <name>Set_Success_Outputs</name>
        <label>Set Success Outputs</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>outputFound</assignToReference>
            <operator>Assign</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>outputStatus</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>varClaim.Status</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>outputLastUpdated</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>varClaim.LastModifiedDate</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>outputDescription</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>varClaim.Description__c</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>outputApproverNotes</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>varClaim.Summary</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>outputClaimId</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>varClaim.Id</elementReference>
            </value>
        </assignmentItems>
    </assignments>
    <decisions>
        <name>Check_Claim_Found</name>
        <label>Claim Found?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Set_Not_Found_Error</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Not Found</defaultConnectorLabel>
        <rules>
            <name>Claim_Found</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varClaim.Id</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Success_Outputs</targetReference>
            </connector>
            <label>Found</label>
        </rules>
    </decisions>
    <description>Gets the current status of an existing warranty claim by claim reference number. Returns status, last updated date, and approver notes.</description>
    <interviewLabel>Check Claim Status {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Check Claim Status</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_Claim_By_Name</name>
        <label>Get Claim By Name</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Check_Claim_Found</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Name</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>inputClaimNumber</elementReference>
            </value>
        </filters>
        <object>Claim</object>
        <outputAssignments>
            <assignToReference>varClaim.Description__c</assignToReference>
            <field>Description__c</field>
        </outputAssignments>
        <outputAssignments>
            <assignToReference>varClaim.Id</assignToReference>
            <field>Id</field>
        </outputAssignments>
        <outputAssignments>
            <assignToReference>varClaim.LastModifiedDate</assignToReference>
            <field>LastModifiedDate</field>
        </outputAssignments>
        <outputAssignments>
            <assignToReference>varClaim.Name</assignToReference>
            <field>Name</field>
        </outputAssignments>
        <outputAssignments>
            <assignToReference>varClaim.Status</assignToReference>
            <field>Status</field>
        </outputAssignments>
        <outputAssignments>
            <assignToReference>varClaim.Summary</assignToReference>
            <field>Summary</field>
        </outputAssignments>
    </recordLookups>
    <runInMode>SystemModeWithSharing</runInMode>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
