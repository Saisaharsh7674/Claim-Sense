            </connector>
            <label>New Min</label>
        </rules>
    </decisions>
    <description>Calculates approval probability, average payout, and payout range from historical claims</description>
    <formulas>
        <name>frmApprovalRate</name>
        <dataType>Number</dataType>
        <expression>IF({!varTotalCounter} &gt; 0, ({!varApprovedCounter} / {!varTotalCounter}) * 100, 0)</expression>
        <scale>1</scale>
    </formulas>
    <formulas>
        <name>frmAvgPayout</name>
        <dataType>Number</dataType>
        <expression>IF({!varItemCounter} &gt; 0, {!varTotalAmount} / {!varItemCounter}, 0)</expression>
        <scale>0</scale>
    </formulas>
    <interviewLabel>Get ClaimPredict Score {!$Flow.CurrentDateTime}</interviewLabel>
