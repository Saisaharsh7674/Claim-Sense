            </connector>
            <label>Has Items</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_Max_Payout</name>
        <label>Check Max Payout</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Process_ClaimItems_Loop</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Not New Max</defaultConnectorLabel>
        <rules>
            <name>New_Max</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>loopClaimItem.TotalAmount__c</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <elementReference>varMaxPayout</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Max_Payout</targetReference>
            </connector>
            <label>New Max</label>
        </rules>
    </decisions>
