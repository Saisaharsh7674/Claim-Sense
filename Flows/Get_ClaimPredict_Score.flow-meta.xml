        </defaultConnector>
        <defaultConnectorLabel>No Items</defaultConnectorLabel>
        <rules>
            <name>Has_Items</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>colClaimItems</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
