            <conditions>
                <leftValueReference>loopClaimItem.TotalAmount__c</leftValueReference>
                <operator>LessThan</operator>
                <rightValue>
                    <elementReference>varMinPayout</elementReference>
                </rightValue>
            </conditions>
            <connector>
