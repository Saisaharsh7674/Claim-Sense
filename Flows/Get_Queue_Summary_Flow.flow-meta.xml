    <decisions>
        <name>Check_Category_Changed</name>
        <label>Check Category Changed</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Check_Is_First_Group</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Changed</defaultConnectorLabel>
        <rules>
            <name>Same_Category</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Loop_Through_Claims.Triage_Category__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>varCurrentCategory</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Increment_Group_Count</targetReference>
            </connector>
            <label>Same</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_Claims_Found</name>
        <label>Check Claims Found</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Set_Empty_Summary</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Not Found</defaultConnectorLabel>
        <rules>
            <name>Claims_Found</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varClaimCollection</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
