            </connector>
            <label>Found</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_Is_First_Group</name>
        <label>Check Is First Group</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Finalize_Prev_Group</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Not First</defaultConnectorLabel>
        <rules>
            <name>First_Group</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>frmCategoryIsBlank</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Start_New_Group</targetReference>
            </connector>
            <label>First</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_Is_First_Name</name>
        <label>Check Is First Name</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Append_Name</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Append</defaultConnectorLabel>
        <rules>
            <name>First_Name</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varGroupNamesCount</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <numberValue>0.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_First_Name</targetReference>
            </connector>
            <label>First Name</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_Names_Limit</name>
        <label>Check Names Limit</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Loop_Through_Claims</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>At Limit</defaultConnectorLabel>
        <rules>
            <name>Under_Limit</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varGroupNamesCount</leftValueReference>
                <operator>LessThan</operator>
                <rightValue>
                    <numberValue>3.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Check_Is_First_Name</targetReference>
            </connector>
            <label>Under Limit</label>
        </rules>
    </decisions>
    <description>Agentforce action — retrieves pending warranty claims (Status = Submitted or Under Review), groups by Triage_Category__c, and returns a summary with claim counts and top 3 claim names per category.</description>
    <environments>Default</environments>
    <formulas>
        <name>frmCategoryIsBlank</name>
        <dataType>Boolean</dataType>
        <expression>ISBLANK({!varCurrentCategory})</expression>
    </formulas>
    <interviewLabel>Get Queue Summary Flow {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Get Queue Summary Flow</label>
    <loops>
        <name>Loop_Through_Claims</name>
        <label>Loop Through Claims</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <collectionReference>varClaimCollection</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Increment_Total</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Finalize_Last_Group</targetReference>
        </noMoreValuesConnector>
    </loops>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_Queue_Claims</name>
        <label>Get Queue Claims</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Check_Claims_Found</targetReference>
        </connector>
        <filterLogic>1 OR 2</filterLogic>
        <filters>
            <field>Status</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Submitted</stringValue>
            </value>
        </filters>
        <filters>
            <field>Status</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Under Review</stringValue>
            </value>
        </filters>
        <object>Claim</object>
        <outputReference>varClaimCollection</outputReference>
        <queriedFields>Id</queriedFields>
        <queriedFields>Name</queriedFields>
        <queriedFields>Status</queriedFields>
        <queriedFields>Triage_Category__c</queriedFields>
        <queriedFields>Risk_Score__c</queriedFields>
        <sortField>Triage_Category__c</sortField>
        <sortOrder>Asc</sortOrder>
    </recordLookups>
    <runInMode>SystemModeWithSharing</runInMode>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Queue_Claims</targetReference>
        </connector>
    </start>
    <status>Active</status>
    <textTemplates>
