    <description>Processes approval or rejection decision from Slack agent. Updates Claim status, sends Custom Notification to dealer, updates Engineering Case if anomaly flagged, and seeds Warranty Observation for Learning Loop.</description>
    <environments>Default</environments>
    <formulas>
        <name>frmApproverIdNotNull</name>
        <dataType>Boolean</dataType>
        <expression>NOT(ISBLANK({!inputApproverId}))</expression>
    </formulas>
    <formulas>
        <name>frmClaimNotFoundMsg</name>
        <dataType>String</dataType>
        <expression>&quot;Claim not found: &quot; &amp; {!inputClaimName}</expression>
    </formulas>
    <formulas>
        <name>frmDecisionPattern</name>
        <dataType>String</dataType>
        <expression>{!inputDecision} &amp; &quot;. Approver: Priya Subramaniam. Notes: &quot; &amp; {!inputApproverNotes}</expression>
    </formulas>
    <formulas>
        <name>frmObservationNote</name>
        <dataType>String</dataType>
        <expression>&quot;Claim &quot; &amp; {!varClaim.Name} &amp; &quot;: &quot; &amp; {!varClaimItem.Failure_Description__c} &amp; &quot; Decision: &quot; &amp; {!inputDecision}</expression>
    </formulas>
